                "exec": [
                  "pm.test(\"Returns null or 404 for invalid product\", function () {",
                  "    const status = pm.response.code;",
                  "    const body = pm.response.text().trim();",
                  "    ",
                  "    const isNotFound = status === 404;",
                  "    const isEmptyBody = body.length === 0;",
                  "    const isNullBody = body === \"null\";",
                  "    ",
                  "    pm.expect(isNotFound || isEmptyBody || isNullBody).to.be.true;",
