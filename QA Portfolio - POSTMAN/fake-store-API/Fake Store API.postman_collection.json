        {
          "name": "get-all-products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a JSON array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Products list is not empty\", function () {",
                  "    pm.expect(pm.response.json().length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Each product has required fields\", function () {",
                  "    const products = pm.response.json();",
                  "    products.forEach(function(product) {",
                  "        pm.expect(product).to.have.property('id');",
                  "        pm.expect(product).to.have.property('title');",
                  "        pm.expect(product).to.have.property('price');",
                  "        pm.expect(product).to.have.property('category');",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Product prices are positive numbers\", function () {",
                  "    const products = pm.response.json();",
                  "    products.forEach(function(product) {",
                  "        pm.expect(product.price).to.be.a('number').and.to.be.above(0);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
